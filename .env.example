# ============================================================================
# OMNISIGHT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to '.env' or '.env.secrets' and fill in your actual credentials.
# DO NOT COMMIT REAL CREDENTIALS TO GIT REPOSITORIES.
# ============================================================================

# 1. AZURE POSTGRESQL DATABASE CONFIGURATION
POSTGRES_HOST=your-postgres-host.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=postgres

# 2. AZURE BLOB STORAGE CONTAINER CONFIGURATION
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_STORAGE_ACCOUNT_KEY=your_storage_account_key
AZURE_STORAGE_CONTAINER_NAME=omnisight-artifacts

# 3. REPOSITORY & ACCESS TOKEN FOR VLM BOT (GH_ prefix compliant with GitHub Secrets)
GH_REPO_URL=https://github.com/your-username/your-repo.git
GH_TOKEN=ghp_your_personal_access_token
GH_BRANCH=dev

# 4. TARGET MOCK STORE BASE URL
BASE_URL=http://your-vm-ip-or-domain:8080
